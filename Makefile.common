# ==============================================================================
# Makefile.common - Shared build configuration for ATmega328P Bare-Metal Course
# ==============================================================================

MCU        := atmega328p
F_CPU      := 16000000UL

CC         := avr-gcc
OBJCOPY    := avr-objcopy
OBJDUMP    := avr-objdump
SIZE       := avr-size
AVRDUDE    := avrdude

PROGRAMMER ?= usbasp
PART       ?= m328p

CFLAGS     := -std=c11 -Os -Wall -Wextra -mmcu=$(MCU) -DF_CPU=$(F_CPU)
LDFLAGS    := -mmcu=$(MCU)
