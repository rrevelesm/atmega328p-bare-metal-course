{
    "configurations": [
        {
            "name": "ATmega328P AVR",
            "compilerPath": "avr-gcc.exe",
            "compilerArgs": [
                "-mmcu=atmega328p"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64",
            "defines": [
                "__AVR__",
                "__AVR_ATmega328P__",
                "F_CPU=16000000UL"
            ],
            "includePath": [
                "${workspaceFolder}/**"
            ]
        }
    ],
    "version": 4
}
